{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfferAnchor AnalyzeRequest 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "revision",
    "locale",
    "clarificationsUsed",
    "evidence"
  ],
  "properties": {
    "contractVersion": {
      "const": "2.0.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "type": "string",
      "enum": [
        "en-HK",
        "zh-Hant-HK"
      ]
    },
    "clarificationsUsed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "sequence",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[1-8]$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "advertisement",
              "offer",
              "instruction",
              "reply",
              "user_note"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "minItems": 1,
      "maxItems": 8
    }
  }
}
