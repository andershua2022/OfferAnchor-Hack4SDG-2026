# OfferAnchor baseline 2.2 / contract 2.0.0 server configuration.
# Workspace and guarded provider plumbing are implemented; simulation is the default.
# Actual core-content approval is recorded on 17 October; deployment/private-data use is separate.
# A clone still needs its own approved server configuration and bounded call authorization.
# Real values belong in ignored .env.local or host secrets; never NEXT_PUBLIC_*.
# Simulation makes no paid calls regardless of MODEL_CALLS_ENABLED.
OFFERANCHOR_MODE=simulation
MODEL_CALLS_ENABLED=false
# Enable only after auth, the account-trial migration and hosted validation.
# Five AI action attempts TOTAL per verified account; no daily reset.
ACCOUNT_TRIAL_ENABLED=false
# Team target: official Model Studio China (Beijing), standard pay-as-you-go API.
# Prefer the exact workspace-specific API Host copied from the regional console.
MODEL_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
# Hosted judging trial and repository use v29/audit1.8.0; see the current repair release record.
# The provider target is still team qwen3.8-max; this file contains no real credentials.
# This clone remains simulation/off by default. No private gateway fallback or automatic retry.
# Independent accuracy is unestablished; extraction is capped at two raw model requests.
MODEL_ID=qwen3.8-max
MODEL_RESPONSE_MODE=json_schema
# Budgets: model 50s, server 53s, browser 58s; delayed jobs 20s.
MODEL_TIMEOUT_MS=50000
SERVER_TIMEOUT_MS=53000
MODEL_MAX_OUTPUT_TOKENS=3000
DEMO_ACCESS_CODE=
APP_SESSION_SECRET=
# Shared-code access does not identify individuals or authorize public deployment.
DEMO_COOKIE_TTL_SECONDS=7200
DEMO_MAX_IN_FLIGHT=1
DEMO_CALL_LIMIT=5
DEMO_CALL_WINDOW_SECONDS=600
GLOBAL_MAX_IN_FLIGHT=2
# Shared guard accepts 1-60; use 60 only for the owner-approved judging window.
GLOBAL_CALL_LIMIT=30
GLOBAL_CALL_WINDOW_SECONDS=86400
# Loopback may use RUNTIME_STATE_MODE=local. Remote HTTPS/Vercel must set RUNTIME_STATE_MODE=shared.
# Remote live/Vercel limits use the applied Supabase runtime-state RPC; no local fallback.
# Two-request model extraction reserves two calls; OCR/search/knowledge reserve one.
# Trial recommendation: at most30 provider requests per24h across all users.
# Global limits still apply when an account has unused actions.

# Server-owned origin and region; confirm against the actual running app/account.
APP_ORIGIN=http://localhost:3000
MODEL_REGION=cn-beijing

# Optional source tools; same origin/auth/content guards and paid-call budget as analysis.
KNOWLEDGE_QA_ENABLED=false
WEB_SEARCH_ENABLED=false
FIRECRAWL_API_KEY=

# Optional Beijing image transcription; core financial interpretation keeps MODEL_ID.
VISION_READING_ENABLED="false"
VISION_MODEL_ID="qwen-vl-ocr-2025-11-20"

# Optional real Google/email accounts: the Auth SSR client uses this publishable key only.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Enable only after configuring and testing a verified email sender.
EMAIL_SIGNUP_PUBLIC_ENABLED="false"

# Shared authentication challenges and atomic usage/concurrency limits.
# Loopback development may use local memory. Remote live/Vercel MUST use shared.
# Apply supabase/migrations/20261018_runtime_state.sql to the existing project first.
RUNTIME_STATE_MODE=local
# Dedicated server-only sb_secret_* (preferred) or legacy service-role JWT.
# Used only by the bounded runtime RPC, never the Auth client or NEXT_PUBLIC_*.
SUPABASE_SERVER_KEY=""
# Challenges expire logically after 600s; claim/concurrency leases after 60s.
# Physical cleanup runs on the next runtime RPC; cloud job history is not implemented.
